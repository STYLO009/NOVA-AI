# NOVA backend (FastAPI + LangGraph + Hugging Face + Qdrant)
# Copy to `backend/.env` and adjust. Every key is optional — NOVA runs with
# safe defaults so a bare `uvicorn nova_backend.main:app` just works.

# ── server ──────────────────────────────────────────────────────────────────
# Bind address. Use 0.0.0.0 to accept connections from other machines/Docker.
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma separated).
#   `*` (default) → open CORS, no cookies; auth uses `Authorization: Bearer`.
#   an explicit list (e.g. http://localhost:8443,http://localhost:8080)
#                 → those origins only, and credentialed cookie requests too.
# The Docker/nginx setup serves the UI on :8080 (same origin → no CORS at all).
NOVA_CORS_ORIGINS=*

# ── workspace ───────────────────────────────────────────────────────────────
# Folder the file tools operate in. Created on demand.
# Default: %USERPROFILE%\Documents\NOVA  (~/Documents/NOVA on Linux)
# NOVA_WORKSPACE=/data/nova

# ── model ───────────────────────────────────────────────────────────────────
# Without HF_TOKEN NOVA still works: the deterministic rule engine takes over
# (llm_mode = "fallback").
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# NOVA_LOCAL_MODEL=

# ── vector database (Qdrant) ────────────────────────────────────────────────
# 1) QDRANT_URL reachable        -> server mode (production, Docker)
# 2) not reachable               -> embedded/local mode at QDRANT_LOCAL_PATH
# 3) vectors disabled entirely   -> set QDRANT_URL="" and QDRANT_LOCAL_PATH=""
# In every case SQLite remains the source of truth; Qdrant only adds recall.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nova_memory
# QDRANT_LOCAL_PATH=

# Embeddings: auto | hf | hashing.
#   auto     -> huggingface when HF_TOKEN is set, signed feature hashing otherwise
#   hf       -> Hugging Face Inference API (requires HF_TOKEN)
#   hashing  -> deterministic local hashing, no network (384 dims)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── auth (multi-user) ───────────────────────────────────────────────────────
# Set to false only for single-user/local experiments — every /api/* route
# (except health + login/register) then becomes open.
NOVA_AUTH_ENABLED=true
# Sliding session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168
PBKDF2_ITERATIONS=390000

# ── behaviour ───────────────────────────────────────────────────────────────
# Seconds a destructive-step confirmation waits before auto-declining.
CONFIRMATION_TIMEOUT_SECONDS=180
POWERSHELL_TIMEOUT_SECONDS=30
ENABLE_BROWSER_AUTOMATION=true
