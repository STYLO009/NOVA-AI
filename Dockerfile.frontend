# ── NOVA frontend ────────────────────────────────────────────────────────────
# Stage 1: build the static bundle with Bun.
FROM oven/bun:1 AS build

WORKDIR /app

# Manifest first so the dependency layer is cached across source-only changes.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .
# `/` => the production build talks to the same origin; nginx proxies /api.
ARG VITE_API_URL=/
ENV VITE_API_URL=${VITE_API_URL}
RUN bun run build

# Stage 2: serve the bundle + reverse-proxy the API with nginx.
FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="NOVA frontend"
LABEL org.opencontainers.image.description="NOVA AI agent dashboard (React + nginx)"

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
